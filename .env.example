DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestor
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/gestor_test

# OpenRouter. Qué modelo usa cada nivel ya no se declara acá: se elige desde
# /configuracion y vive en `model_catalog` y `organization_models`.
OPENROUTER_API_KEY=

# Modo seco: usa el cliente falso, no gasta tokens (Task 4)
# El worker no arranca sin una de las dos: o `OPENROUTER_API_KEY` con valor, o
# `IA_EN_SECO=true`. Con ambas vacías sale con error al construir el cliente.
IA_EN_SECO=false
CARPETA_DE_MUESTRAS=packages/strategy/muestras

# Autenticación (bloque 1C-A). En local basta SESION_DE_DESARROLLO=true, sin
# necesidad de AUTH_SECRET: el middleware llama a `auth()` en cada petición
# de página, esa llamada pide su propia sesión a `@auth/core` y esa petición
# interna sí falla por falta de secreto, pero el fallo se descarta antes de
# llegar al callback `authorized` — que con la sesión de desarrollo deja
# pasar igual. Lo único que deja es `[auth][error] MissingSecret` en el log,
# una vez por petición de página: inofensivo, pero se ve como un error real.
# AUTH_SECRET sí hace falta para el inicio de sesión real (sin sesión de
# desarrollo). AUTH_GOOGLE_ID/SECRET y CORREOS_PERMITIDOS solo hacen falta
# para probar el inicio de sesión real. Sin CORREOS_PERMITIDOS no entra
# nadie: es la lista de autorización, no una de las tres de Auth.js.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
CORREOS_PERMITIDOS=

# Sesión de mentira para desarrollo. Se IGNORA fuera de NODE_ENV=development,
# así que dejarla encendida no abre nada en producción.
SESION_DE_DESARROLLO=true

# La base en Cloud SQL (bloque 1C-A2). En local NO se declaran: sin
# CLOUD_SQL_INSTANCIA la conexión usa DATABASE_URL y va a Docker, que es lo
# que quieres en tu máquina, en el CLI, en el worker y en las pruebas.
#
# Estas cinco se cargan solo en Vercel. CLOUD_SQL_INSTANCIA es el nombre de
# conexión de la instancia, con la forma proyecto:región:instancia — no es el
# nombre que le pusiste, sale en la ficha de la instancia.
# CLOUD_SQL_INSTANCIA=
# CLOUD_SQL_USUARIO=
# CLOUD_SQL_CLAVE=
# CLOUD_SQL_BASE=
# GOOGLE_CREDENCIALES_JSON=

# Despertar al worker (bloque 1C-B). Estas CINCO en local NO se declaran: el
# worker de Docker sondea solo, así que no hay a quién avisar. Se cargan solo
# en Vercel, y van las cinco (más WORKER_TOKEN, abajo) o ninguna: una
# configuración a medias falla con un mensaje que nombra lo que falta, en vez
# de dejar la web encolando sin despertar a nadie.
#
# WORKER_URL es la URL del servicio de Cloud Run, sin ruta ni barra final.
# CLOUD_TASKS_PROYECTO=
# CLOUD_TASKS_REGION=
# CLOUD_TASKS_COLA=
# WORKER_URL=
# WORKER_CUENTA_DE_SERVICIO=

# WORKER_TOKEN sí va en local, y es la excepción de las seis: es el token
# compartido que el worker exige en la cabecera `x-token-worker`, y sin él
# `pnpm --filter @gc/worker start` no arranca. Dentro de `docker compose` no
# hace falta —`docker-compose.yml` la fija a "local" en el bloque
# `environment:`—, pero levantar el worker en el host la necesita.
#
# Tenerla SOLA no es «configurado a medias»: `destinoDelDespertador`
# (`packages/despertador/src/destino.ts`) la trata aparte justamente porque es
# la única con consumidor local, así que con las otras cinco ausentes el
# destino es `ninguno` y silencioso. En Vercel tiene que valer lo mismo que en
# el servicio de Cloud Run.
WORKER_TOKEN=local
